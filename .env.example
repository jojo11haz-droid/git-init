# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key for server-side check-in summarization.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon/Supabase/Render all provide one).
# Check-ins, patients, and clinician accounts persist here.
DATABASE_URL=

# Set to "disable" only for a local Postgres without SSL (e.g. localhost dev).
# Leave unset for hosted providers.
# DATABASE_SSL=disable

# Optional: email delivery via Resend (resend.com) — used for clinician
# password-reset links and risk-alert notifications. Without it, emails are
# printed to the server logs instead of being sent.
# RESEND_API_KEY=
# EMAIL_FROM=Between <onboarding@resend.dev>

# Optional: payments via Stripe — lets self-serve patients subscribe to a
# Personal plan. Without STRIPE_SECRET_KEY set, patient signup still works but
# creates the account for free (no charge). To turn on real charging:
#   1. Create products/prices in the Stripe dashboard for the two plans.
#   2. Paste the secret key and the two price ids below.
#   3. (Recommended) Add a webhook endpoint pointing at /api/stripe/webhook
#      and paste its signing secret, so cancellations/renewals stay in sync.
# Use test keys (sk_test_… / price_… from test mode) until you're ready to go live.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PATIENT_MONTHLY=
# STRIPE_PRICE_PATIENT_ANNUAL=
# STRIPE_PRICE_THERAPIST_MONTHLY=   # Solo plan — clinicians get a 14-day trial
# STRIPE_PRICE_THERAPIST_ANNUAL=    # Solo Annual plan
# STRIPE_PRICE_TEAM_MONTHLY=        # Team plan — coaches get a 14-day trial ($99/mo)
# STRIPE_PRICE_TEAM_ANNUAL=         # Team Annual plan ($948/yr)
# STRIPE_PRICE_TEAM_PREMIUM=        # Premium plan, squads over 30 players ($199/mo)
# STRIPE_PRICE_MENTOR_MONTHLY=      # Mentor plan (addiction recovery) — 14-day trial
# STRIPE_PRICE_MENTOR_ANNUAL=       # Mentor Annual plan
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_BASE_URL=https://your-site.onrender.com   # used to build Stripe return URLs

# Optional: speech-to-text via Deepgram (deepgram.com) — transcribes voice
# memos server-side so they flow through the same AI summary + risk screening
# as typed check-ins. Without it, voice memos are stored and playable but NOT
# transcribed or risk-screened.
# DEEPGRAM_API_KEY=
